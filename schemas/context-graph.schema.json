{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mshir0/context-graph-deepseek-harness/schemas/context-graph.schema.json",
  "title": "Context Graph",
  "type": "object",
  "required": ["version", "projectPath", "nodes", "edges", "overrides"],
  "properties": {
    "version": { "const": 1 },
    "projectPath": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["functional", "code_module", "implementation_file", "implementation_class", "implementation_function", "implementation_package", "implementation_symbol", "requirement", "task", "constraint", "decision", "interface", "documentation", "conversation", "artifact", "test", "issue", "note", "project_rule"] },
          "title": { "type": "string" },
          "label": { "type": "string" },
          "content": { "type": "string" },
          "description": { "type": "string" },
          "provides": { "type": "array", "items": { "type": "string" } },
          "consumes": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "source": { "type": "string" },
          "created_by": { "enum": ["user", "ai", "auto", "analyzer", "plugin", "system"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "derived_from": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "last_verified": { "type": "string" },
          "subject": { "type": "string" },
          "slot": { "type": "string" },
          "value": { "type": "string" },
          "priority": { "enum": ["critical", "high", "normal", "low"] },
          "status": { "enum": ["active", "resolved", "deprecated", "superseded", "archived", "stale"] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "metadata": { "type": "object" },
          "path": { "type": "string" },
          "mode": { "enum": ["AUTO", "MANUAL", "FORCE_INCLUDE", "FORCE_EXCLUDE"] },
          "scope": { "$ref": "#/$defs/scope" },
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "scope"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": { "enum": ["dependency", "reference", "interface", "data", "optional", "force_include", "force_exclude", "depends_on", "calls", "references", "affects", "constrains", "implements", "implemented_by", "derived_from", "conflicts_with", "supersedes", "related_to", "contains", "uses", "provides", "consumes", "produces", "feeds", "transforms", "triggers", "tests", "documents", "targets", "requires", "constrained_by", "applies_to"] },
          "mode": { "enum": ["AUTO", "MANUAL", "FORCE_INCLUDE", "FORCE_EXCLUDE"] },
          "scope": { "$ref": "#/$defs/scope" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["functional", "implementation"],
        "properties": {
          "functional": { "type": "string" },
          "implementation": { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" }, "path": { "type": "string" }, "capabilities": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": true }] } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "created_by": { "enum": ["auto", "ai", "user"] },
          "mode": { "enum": ["AUTO", "MANUAL", "FORCE_INCLUDE", "FORCE_EXCLUDE"] }
        },
        "additionalProperties": true
      }
    },
    "overrides": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } },
        "deleted": { "type": "array", "uniqueItems": true, "items": { "type": "string" }, "description": "User-deleted implementation node tombstones; scanners must not recreate them." }
      }
    },
    "policy": {
      "type": "object",
      "description": "Project-level Context Policy overrides. Runtime defaults remain authoritative for omitted fields."
    },
    "cache": {
      "type": "object",
      "properties": {
        "revision": { "type": "string" },
        "invalidated": { "type": "array", "items": { "type": "string" } },
        "updated_at": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "scope": { "type": "array", "uniqueItems": true, "items": { "enum": ["code", "context", "interface", "contract", "state", "decisions", "history", "content"] } }
  }
}
