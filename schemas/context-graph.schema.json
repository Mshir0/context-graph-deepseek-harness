{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Mshir0/context-graph-deepseek-harness/schemas/context-graph.schema.json",
  "title": "Context Graph",
  "type": "object",
  "required": ["version", "projectPath", "nodes", "edges", "overrides"],
  "properties": {
    "version": { "const": 1 },
    "projectPath": { "type": "string" },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "type": { "enum": ["code_module", "requirement", "task", "constraint", "decision", "interface", "documentation", "conversation", "artifact", "test", "issue", "note", "project_rule"] },
          "title": { "type": "string" },
          "label": { "type": "string" },
          "content": { "type": "string" },
          "source": { "type": "string" },
          "priority": { "enum": ["critical", "high", "normal", "low"] },
          "status": { "enum": ["active", "resolved", "deprecated", "superseded", "archived"] },
          "created_at": { "type": "string" },
          "updated_at": { "type": "string" },
          "metadata": { "type": "object" },
          "path": { "type": "string" },
          "mode": { "enum": ["AUTO", "MANUAL", "FORCE_INCLUDE", "FORCE_EXCLUDE"] },
          "scope": { "$ref": "#/$defs/scope" },
          "x": { "type": "number" },
          "y": { "type": "number" }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "type", "scope"],
        "properties": {
          "source": { "type": "string" },
          "target": { "type": "string" },
          "type": { "enum": ["dependency", "reference", "interface", "data", "optional", "force_include", "force_exclude", "depends_on", "calls", "references", "affects", "constrains", "implements", "derived_from", "conflicts_with", "supersedes", "related_to", "contains", "uses", "produces", "tests", "documents", "targets", "requires", "constrained_by", "applies_to"] },
          "mode": { "enum": ["AUTO", "MANUAL", "FORCE_INCLUDE", "FORCE_EXCLUDE"] },
          "scope": { "$ref": "#/$defs/scope" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "metadata": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "overrides": {
      "type": "object",
      "required": ["include", "exclude"],
      "properties": {
        "include": { "type": "array", "items": { "type": "string" } },
        "exclude": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "scope": { "type": "array", "uniqueItems": true, "items": { "enum": ["code", "context", "interface", "contract", "state", "decisions", "history", "content"] } }
  }
}
